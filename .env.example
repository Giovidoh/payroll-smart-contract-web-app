# Contrat de demonstration (intervalle de 10 s) : rend un cycle complet observable en seance.
# Contrat de production (intervalle de 2 592 000 s) :
#   NEXT_PUBLIC_PAYROLL_ADDRESS=0xA15fBb6884b64A93B453628abd9b181D434D206A
#   NEXT_PUBLIC_TOKEN_ADDRESS=0x44a0E5caF4a097583a9384c8Ef78403Ee2a2C1bc
NEXT_PUBLIC_PAYROLL_ADDRESS=0x68B5Fc5B4B57dFBEE5d295BA25da36790aA68340
NEXT_PUBLIC_TOKEN_ADDRESS=0x6d8a78Bc479cF9C891b2417EC08c6C885e1713cB
NEXT_PUBLIC_TOKEN_SYMBOL=mUSDC

# Laisser vide pour le point d'acces public de Sepolia.
NEXT_PUBLIC_RPC_URL=

# Bloc de creation du contrat (broadcast/DeployPayroll.s.sol/11155111/run-latest.json).
NEXT_PUBLIC_DEPLOY_BLOCK=11642468

# Etendue maximale d un eth_getLogs, en blocs. Le point d acces public thirdweb
# plafonne a 1000 ; un point d acces nominatif (Alchemy, Infura) permet bien plus,
# et reduit d autant le nombre de requetes du balayage initial.
NEXT_PUBLIC_LOG_RANGE=200000

# Point d acces dedie aux journaux (eth_getLogs). Voir le commentaire dans
# lib/contracts/config.ts : les plafonds different de ceux des lectures ordinaires.
NEXT_PUBLIC_LOGS_RPC_URL=https://sepolia.gateway.tenderly.co

# --- Couche hors chaine (MySQL) -------------------------------------------
# La base tourne dans le conteneur decrit par docker-compose.yml :
#   docker compose up -d
DATABASE_URL=mysql://paie:paie-dev@127.0.0.1:3306/paie_blockchain

# Clef de scellement du cookie de session. En engendrer une par installation :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# La changer invalide toutes les sessions en cours.
SESSION_SECRET=
